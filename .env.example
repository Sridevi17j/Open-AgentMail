# Copy to .env and export the variables yourself. Open-AgentMail does not load .env files.
# AGENTBOX_* still works when the matching OPEN_AGENTMAIL_* variable is unset.
OPEN_AGENTMAIL_DOMAIN=temp.local
OPEN_AGENTMAIL_SMTP_HOST=127.0.0.1
OPEN_AGENTMAIL_SMTP_PORT=2525
OPEN_AGENTMAIL_SMTP_ENABLED=true
OPEN_AGENTMAIL_HTTP_HOST=127.0.0.1
OPEN_AGENTMAIL_HTTP_PORT=8791
OPEN_AGENTMAIL_HTTP_ENABLED=true
OPEN_AGENTMAIL_DATA_DIR=./data
OPEN_AGENTMAIL_PERSIST=true
OPEN_AGENTMAIL_AUTO_CREATE=false
OPEN_AGENTMAIL_INBOX_TTL_SECONDS=3600
# Set this before binding HTTP on a non-loopback address.
# OPEN_AGENTMAIL_API_TOKEN=
# OPEN_AGENTMAIL_ALLOW_OPEN_HTTP=false
