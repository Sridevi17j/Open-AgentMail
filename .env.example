# Copy to .env and export the variables yourself. Agentbox does not load .env files.
AGENTBOX_DOMAIN=temp.local
AGENTBOX_SMTP_HOST=127.0.0.1
AGENTBOX_SMTP_PORT=2525
AGENTBOX_SMTP_ENABLED=true
AGENTBOX_HTTP_HOST=127.0.0.1
AGENTBOX_HTTP_PORT=8791
AGENTBOX_HTTP_ENABLED=true
AGENTBOX_DATA_DIR=./data
AGENTBOX_PERSIST=true
AGENTBOX_AUTO_CREATE=false
AGENTBOX_INBOX_TTL_SECONDS=3600
# Set this before binding HTTP on a non-loopback address.
# AGENTBOX_API_TOKEN=
# AGENTBOX_ALLOW_OPEN_HTTP=false
